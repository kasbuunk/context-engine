#!/usr/bin/env python3
"""Read-only MCP server over the `ce` CLI (stdio, JSON-RPC 2.0).

An adapter, not part of the store: it only runs `ce search|show|up|down|stale`
against $CE_DB and never writes. Python stdlib only; delete this directory and
`ce` is unaffected (SPEC §5: "an MCP server over these same verbs is a later,
optional wrapper").

Register it with an MCP client, e.g. Claude Code:
  claude mcp add -s user ce -e CE_DB=/path/ce.db -- /path/adapters/mcp/ce-mcp
"""

import json
import os
import subprocess
import sys

CE = os.environ.get("CE", "ce")
MAX_TEXT = int(os.environ.get("CE_MCP_MAX_TEXT", "40000"))
PROTOCOL = "2025-06-18"

HASH = {"type": "string", "description": "Artifact hash or unique prefix (8+ hex chars)."}
TOOLS = [
    {
        "name": "search",
        "description": (
            "Full-text search over the current (not superseded) artifacts in the "
            "context engine: what Kas recorded, transcribed and wrote, with provenance. "
            "Query is SQLite FTS5 syntax: words are ANDed, \"exact phrase\", OR, prefix*. "
            "Returns one line per hit: hash, kind (source|synthesis), type, path, date, snippet."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "query": {"type": "string"},
                "limit": {"type": "integer", "default": 20, "minimum": 1, "maximum": 200},
            },
            "required": ["query"],
        },
    },
    {
        "name": "show",
        "description": (
            "One artifact in full: its spec (how it was made or where it came from), "
            "its content, its edges in both directions and the footnote chain down to "
            "its sources. Use after search to read a hit."
        ),
        "inputSchema": {"type": "object", "properties": {"hash": HASH}, "required": ["hash"]},
    },
    {
        "name": "up",
        "description": "Upstream walk: everything this artifact rests on, down to raw sources (zoom in).",
        "inputSchema": {"type": "object", "properties": {"hash": HASH}, "required": ["hash"]},
    },
    {
        "name": "down",
        "description": "Downstream walk: everything built on this artifact (summaries, notes that cite it).",
        "inputSchema": {"type": "object", "properties": {"hash": HASH}, "required": ["hash"]},
    },
    {
        "name": "stale",
        "description": "Current syntheses whose subject has since been superseded: claims built on outdated versions.",
        "inputSchema": {"type": "object", "properties": {}},
    },
]


def ce(*args):
    p = subprocess.run([CE, *args], capture_output=True, text=True, timeout=60)
    if p.returncode != 0:
        raise RuntimeError(p.stderr.strip() or f"ce {args[0]} failed ({p.returncode})")
    return [json.loads(line) for line in p.stdout.splitlines() if line.strip()]


def where(spec):
    """Short human handle for an artifact: its path, or its spec type."""
    spec = spec or {}
    return spec.get("path") or spec.get("type", "?")


def when(spec):
    spec = spec or {}
    return (spec.get("committed_at") or "")[:10]


def walk_line(r):
    pad = "  " * int(r.get("depth") or 0)
    mark = "" if r.get("current", True) else " (superseded)"
    return f"{pad}{r['hash'][:12]} {r['kind']} {r.get('type', '')} via={r.get('via')} status={r.get('status')}{mark}"


def call(name, args):
    if name == "search":
        rows = ce("search", args["query"])[: int(args.get("limit") or 20)]
        if not rows:
            return "no hits"
        return "\n".join(
            f"{r['hash'][:12]} {r['kind']} {where(r.get('spec'))} {when(r.get('spec'))}\n    "
            + (r.get("snippet") or "").replace("\n", " ")
            for r in rows
        )
    if name == "show":
        rows = ce("show", args["hash"])
        return json.dumps(rows[0] if len(rows) == 1 else rows, ensure_ascii=False, indent=1)
    if name in ("up", "down"):
        rows = ce(name, args["hash"])
        return "\n".join(walk_line(r) for r in rows) or "nothing"
    if name == "stale":
        rows = ce("stale")
        return "\n".join(json.dumps(r, ensure_ascii=False) for r in rows) or "nothing is stale"
    raise KeyError(name)


def handle(msg):
    method, mid = msg.get("method"), msg.get("id")
    if mid is None:  # notification
        return None
    if method == "initialize":
        version = (msg.get("params") or {}).get("protocolVersion", PROTOCOL)
        result = {
            "protocolVersion": version,
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "ce", "version": "0.1.0"},
            "instructions": (
                "Kas's context engine: his recorded, transcribed and written material, "
                "with provenance (what rests on what) and versions. Search first, then "
                "show a hit; walk up to check a claim against its sources."
            ),
        }
    elif method == "ping":
        result = {}
    elif method == "tools/list":
        result = {"tools": TOOLS}
    elif method == "tools/call":
        p = msg.get("params") or {}
        try:
            text, err = call(p.get("name"), p.get("arguments") or {}), False
        except KeyError as e:
            return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32602, "message": f"unknown tool or argument {e}"}}
        except Exception as e:  # ce failed: report to the model, don't crash
            text, err = str(e), True
        if len(text) > MAX_TEXT:
            text = text[:MAX_TEXT] + f"\n… truncated at {MAX_TEXT} chars"
        result = {"content": [{"type": "text", "text": text}], "isError": err}
    else:
        return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": f"no method {method}"}}
    return {"jsonrpc": "2.0", "id": mid, "result": result}


def main():
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            out = {"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "parse error"}}
        else:
            out = handle(msg)
        if out is not None:
            sys.stdout.write(json.dumps(out, ensure_ascii=False) + "\n")
            sys.stdout.flush()


if __name__ == "__main__":
    main()
